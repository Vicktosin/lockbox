{
  "name": "lockbox",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false && npm run typecheck:server",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "test:frontend": "node --test scripts/check-frontend.mjs",
    "dev:server": "node --env-file-if-exists=server/.env --experimental-strip-types server/index.ts",
    "typecheck:server": "tsc -p tsconfig.server.json --pretty false",
    "test:storage": "node --experimental-strip-types --test scripts/check-storage.mjs",
    "db:init": "node --env-file-if-exists=server/.env --experimental-strip-types server/cli.ts db:init",
    "db:check": "node --env-file-if-exists=server/.env --experimental-strip-types server/cli.ts db:check",
    "db:migrate": "node --env-file-if-exists=server/.env --experimental-strip-types server/cli.ts db:migrate",
    "db:backup": "node --env-file-if-exists=server/.env --experimental-strip-types server/cli.ts db:backup",
    "db:restore": "node --env-file-if-exists=server/.env --experimental-strip-types server/cli.ts db:restore",
    "key:init": "node --env-file-if-exists=server/.env --experimental-strip-types server/cli.ts key:init",
    "key:check": "node --env-file-if-exists=server/.env --experimental-strip-types server/cli.ts key:check",
    "test:backend": "node --experimental-strip-types --test scripts/check-backend.mjs",
    "auth:invite": "node --env-file-if-exists=server/.env --experimental-strip-types server/cli.ts auth:invite",
    "test:auth": "node --experimental-strip-types --test scripts/check-auth.mjs",
    "test:vault": "node --experimental-strip-types --test scripts/check-vault.mjs",
    "test:drive": "node --experimental-strip-types --test scripts/check-drive.mjs",
    "test:recovery": "node --experimental-strip-types --test scripts/check-recovery.mjs",
    "recovery:restore": "node --experimental-strip-types scripts/restore-complete.mjs",
    "test:rehearsal": "node --experimental-strip-types --test scripts/check-rehearsal.mjs",
    "recovery:assistant": "node --env-file-if-exists=server/.env --experimental-strip-types scripts/recovery-assistant.mjs",
    "test:deployment": "node --experimental-strip-types --test scripts/check-deployment.mjs",
    "test:offdevice": "node --experimental-strip-types --test scripts/check-offdevice.mjs",
    "test:onboarding": "node --experimental-strip-types --test scripts/check-onboarding.mjs",
    "test:dev-boundary": "node --experimental-strip-types --test scripts/check-dev-boundary.mjs",
    "test:browser-runtime": "node --experimental-strip-types --test scripts/check-browser-runtime.mjs",
    "test:caddy": "node --experimental-strip-types --test scripts/check-caddy.mjs",
    "validation:prepare-caddy": "node --experimental-strip-types scripts/prepare-caddy.mjs",
    "validation:environment": "node --env-file-if-exists=server/.env --experimental-strip-types scripts/validate-environment.mjs",
    "test:all": "node --experimental-strip-types --test --test-concurrency=1 scripts/check-backend.mjs scripts/check-auth.mjs scripts/check-vault.mjs scripts/check-storage.mjs scripts/check-onboarding.mjs scripts/check-dev-boundary.mjs scripts/check-frontend.mjs scripts/check-browser-runtime.mjs scripts/check-drive.mjs scripts/check-recovery.mjs scripts/check-offdevice.mjs scripts/check-deployment.mjs scripts/check-caddy.mjs scripts/check-rehearsal.mjs scripts/check-installation.mjs scripts/check-extension.mjs scripts/check-private-deployment.mjs scripts/check-startup.mjs",
    "install:prepare": "node --env-file-if-exists=server/.env --experimental-strip-types scripts/install-prepare.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "release:package": "node scripts/package-release.mjs",
    "test:installation": "node --experimental-strip-types --test scripts/check-installation.mjs",
    "test:extension": "node --experimental-strip-types --test scripts/check-extension.mjs",
    "deployment:prepare": "node --experimental-strip-types scripts/prepare-private-deployment.mjs",
    "test:private-deployment": "node --experimental-strip-types --test scripts/check-private-deployment.mjs",
    "test:startup": "node --experimental-strip-types --test scripts/check-startup.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@noble/ciphers": "2.4.0",
    "@radix-ui/react-slot": "^1.5.0",
    "argon2": "0.45.2",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fastify": "5.12.8",
    "hash-wasm": "4.13.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  }
}
