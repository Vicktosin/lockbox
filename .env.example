# Public Google OAuth web client ID; no client secret is used by this app.
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_WEB_CLIENT_ID

# Public API key (restrict by deployed website origin and Drive API).
GOOGLE_API_KEY=REPLACE_WITH_RESTRICTED_GOOGLE_API_KEY

# Google Cloud project number used by Google Picker.
GOOGLE_APP_ID=REPLACE_WITH_GOOGLE_CLOUD_PROJECT_NUMBER
