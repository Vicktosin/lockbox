# Backend-only development configuration. Copy to server/.env only if overrides are needed.
NODE_ENV=development
LOCKBOX_BACKEND_PORT=8787
LOCKBOX_LOG_LEVEL=info
LOCKBOX_APP_ORIGIN=http://localhost:5173
# Development defaults are private, ignored server/.data/db, keys and backups directories.
# Overrides must be absolute paths, outside public/source folders.
# Production requires all four paths/origin explicitly and storage outside the project.
# LOCKBOX_DB_PATH=C:\private-lockbox\db\lockbox.sqlite
# LOCKBOX_KEY_FILE=C:\private-lockbox\keys\application-key.json
# LOCKBOX_BACKUP_DIR=C:\private-lockbox\backups

# Legacy optional folder setting; inactive, never grants permissions.
GOOGLE_DRIVE_FOLDER_ID=1AIiW6Ce2NZyp8Z0CKyWphHHEh3NcUxTb
# Developer/deployer configuration only. The user connects by folder link in Settings.
# Register a confidential Google web application and enable Drive API v3 before deployment.
# LOCKBOX_GOOGLE_CLIENT_ID=deployment-provided-client-id
# LOCKBOX_GOOGLE_CLIENT_SECRET=deployment-provided-secret
# Registered redirect URI must exactly match LOCKBOX_APP_ORIGIN/api/drive/callback.
# Do not put secrets in VITE_ variables. Missing registration keeps Connect unavailable.
# Developer-only recovery registration: also register http://127.0.0.1:18888/callback.
# The temporary private recovery assistant reuses these confidential client credentials.
# Household users only approve Google consent and keep their emergency recovery record.
