[Unit]
Description=Lockbox private household backend
After=network.target
[Service]
Type=simple
User=lockbox
Group=lockbox
WorkingDirectory=/opt/lockbox
Environment=NODE_ENV=production
EnvironmentFile=/etc/lockbox/backend.env
ExecStart=/usr/bin/node --experimental-strip-types server/index.ts
ExecStartPost=/usr/bin/node scripts/deployment-health.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
TimeoutStartSec=120
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/lockbox
RestrictSUIDSGID=true
[Install]
WantedBy=multi-user.target
